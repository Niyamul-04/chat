# Port (Render sets this automatically via process.env.PORT)
PORT=5000

# Client origin for CORS (e.g. https://your-app.onrender.com or your Vercel URL)
CLIENT_URL=http://localhost:5173

# Secret key for JWT auth (REQUIRED: replace with a strong random string in Render)
JWT_SECRET=your_jwt_secret_change_in_production

# Database URL for Prisma (SQLite or PostgreSQL)
DATABASE_URL="file:./dev.db"

# Optional WebRTC TURN server for cellular/symmetric NAT connections
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
