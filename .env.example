# ==========================================
# ChatSphere Environment Configuration
# ==========================================

# Port for the Node.js server (Render automatically sets this in production)
PORT=5000

# Client frontend URL for CORS (set to your Vercel or Render domain in production)
# e.g., https://chatsphere.onrender.com or https://chatsphere-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# Secret key used to sign JWT authentication cookies and tokens
# Set this to a random 32+ character string in Render environment variables
JWT_SECRET=your_jwt_secret_change_in_production

# Prisma Database connection URL:
# For SQLite (default zero-config):
DATABASE_URL="file:./dev.db"
# For PostgreSQL (e.g. Render PostgreSQL or Supabase):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# (Optional) WebRTC TURN server for strict NAT / mobile data calls
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# (Optional) Frontend build-time variable if deploying client separately to Vercel/Netlify
VITE_SERVER_URL=http://localhost:5000
